{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "football-fraud-ai",
  "main": "worker/index.js",
  "compatibility_date": "2026-06-25",
  "triggers": {
    "crons": ["*/20 * * * *"]
  },
  "routes": [
    {
      "pattern": "futbots.cc",
      "custom_domain": true
    },
    {
      "pattern": "admin.futbots.cc",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "single-page-application",
    // Everything goes through the Worker. The region check and the hostname split both
    // have to see every request, and a path the asset layer answers on its own is a
    // path where neither applies. The boolean form of this setting did not reach the
    // Worker for HTML paths, so the route list says the same thing explicitly.
    "run_worker_first": ["/*"]
  },
  "vars": {
    "OPENROUTER_BASE_URL": "https://openrouter.ai/api/v1",
    "OPENAI_BASE_URL": "https://api.openai.com/v1",
    "APIMART_BASE_URL": "https://api.apimart.ai/api/v1",
    "ALLSCALE_BASE_URL": "https://openapi.allscale.io",
    "AUTH_SITE_URL": "https://futbots.cc",
    // Setting this moves the console off the public site. Unset - local development -
    // keeps it at /admin on the same origin.
    "ADMIN_HOSTNAME": "admin.futbots.cc",
    "TELEGRAM_AUTH_ENABLED": "true",
    "API_FOOTBALL_BASE_URL": "https://api-football-proxy.64-186-226-161.sslip.io",
    // Kept in step with DEFAULT_API_FOOTBALL_LEAGUES in src/api-football-cache.js.
    "API_FOOTBALL_LEAGUES": "39,140,78,135,61,2,3,94,88,203,144,235,179,253,262,71,128,98,292,188",
    "API_FOOTBALL_DAILY_LIMIT": "7500",
    // The OpenRouter account's billing region has no access to OpenAI, Anthropic or
    // Google — those answer 403 there and changing the billing address did not lift it.
    // Qwen stays on OpenRouter because it is unaffected and OpenRouter reports its cost;
    // APIMart reports none, and the champion model runs on most predictions.
    // Verify any change with the model check in /admin.
    "MODEL_GPT": "gpt-5.5",
    "MODEL_GPT_PROVIDER": "openai",
    "MODEL_GPT_LABEL": "GPT 5.5",
    "MODEL_CLAUDE": "claude-opus-4-8",
    "MODEL_CLAUDE_PROVIDER": "apimart",
    "MODEL_CLAUDE_LABEL": "Claude 4.8",
    "MODEL_GEMINI": "gemini-3.1-pro-preview",
    "MODEL_GEMINI_PROVIDER": "apimart",
    "MODEL_GEMINI_LABEL": "Gemini",
    "MODEL_QWEN": "qwen/qwen3.7-max",
    "MODEL_QWEN_PROVIDER": "openrouter",
    "MODEL_QWEN_LABEL": "Qwen 3.7 Max",
    // deepseek-chat, not deepseek-v4-pro: measured on the real ranking prompt, v4-pro
    // took 257s and returned no qualifying picks, which no visitor waits for and the
    // Worker would not survive. This one answered in 22s for $0.0012.
    "MODEL_DEEPSEEK": "deepseek/deepseek-chat",
    "MODEL_DEEPSEEK_PROVIDER": "openrouter",
    "MODEL_DEEPSEEK_LABEL": "DeepSeek"
  }
}
